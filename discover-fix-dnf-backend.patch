+static void addCachedIconFile(QIcon &ico, const QString &pathOrName, const QSize &size)
 {
+    if (pathOrName.isEmpty()) {
+        return;
+    }
+    if (QFileInfo::exists(pathOrName)) {
+        ico.addFile(pathOrName, size);
+        return;
+    }
+    // AppStream often stores relative names; look up the swcatalog / app-info icon cache.
+    const QStringList roots = {
+        QStringLiteral("/var/cache/swcatalog/icons"),
+        QStringLiteral("/usr/share/swcatalog/icons"),
+        QStringLiteral("/var/lib/swcatalog/icons"),
+        QStringLiteral("/usr/share/app-info/icons"),
+        QStringLiteral("/var/lib/app-info/icons"),
+        QStringLiteral("/var/cache/app-info/icons"),
+    };
+    const QString fileName = QFileInfo(pathOrName).fileName();
+    for (const QString &root : roots) {
+        if (!QFileInfo::exists(root)) {
+            continue;
+        }
+        // Prefer size-specific dirs when we know the size
+        if (size.isValid() && size.width() > 0) {
+            const QString sized = root + QLatin1Char('/') + QString::number(size.width()) + QLatin1Char('x') + QString::number(size.height())
+                + QLatin1Char('/') + fileName;
+            // Also search per-repo subdirs: root/<repo>/<WxH>/file
+            QDirIterator sizedIt(root, QStringList{fileName}, QDir::Files, QDirIterator::Subdirectories);
+            while (sizedIt.hasNext()) {
+                const QString found = sizedIt.next();
+                // Prefer matching size in path
+                if (found.contains(QString::number(size.width()) + QLatin1Char('x') + QString::number(size.height()))) {
+                    ico.addFile(found, size);
+                    return;
+                }
+            }
+            Q_UNUSED(sized)
+        }
+        QDirIterator it(root, QStringList{fileName}, QDir::Files, QDirIterator::Subdirectories);
+        if (it.hasNext()) {
+            ico.addFile(it.next(), size);
+            return;
+        }
+    }
+}
