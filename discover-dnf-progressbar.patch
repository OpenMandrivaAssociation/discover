+class ProgressReporter
+{
+public:
+    explicit ProgressReporter(DnfContext::ProgressCallback cb)
+        : m_cb(std::move(cb))
+    {
+    }
+
+    void set(int percent)
+    {
+        percent = std::clamp(percent, 0, 100);
+        if (!m_cb || percent <= m_last) {
+            return;
+        }
+        m_last = percent;
+        m_cb(percent);
+    }
+
+    void setAtLeast(int percent)
+    {
+        if (percent > m_last) {
+            set(percent);
+        }
+    }
+
+private:
+    DnfContext::ProgressCallback m_cb;
+    int m_last = -1;
+};
