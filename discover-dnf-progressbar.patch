+class ProgressDownloadCallbacks : public libdnf5::repo::DownloadCallbacks
+{
+public:
+    explicit ProgressDownloadCallbacks(ProgressReporter &reporter)
+        : m_reporter(reporter)
+    {
+    }
+
+    void *add_new_download(void * /*user_data*/, const char * /*description*/, double total_to_download) override
+    {
+        auto *slot = new DownloadSlot;
+        slot->total = total_to_download > 0 ? total_to_download : 0;
+        m_slots.insert(slot);
+        updateProgress();
+        return slot;
+    }
+
+    int progress(void *user_cb_data, double total_to_download, double downloaded) override
+    {
+        auto *slot = static_cast<DownloadSlot *>(user_cb_data);
+        if (slot) {
+            if (total_to_download > 0) {
+                slot->total = total_to_download;
+            }
+            slot->done = downloaded;
+            updateProgress();
+        }
+        return ReturnCode::OK;
+    }
+
+    int end(void *user_cb_data, TransferStatus /*status*/, const char * /*msg*/) override
+    {
+        auto *slot = static_cast<DownloadSlot *>(user_cb_data);
+        if (slot) {
+            if (slot->total > 0) {
+                slot->done = slot->total;
+            } else if (slot->done <= 0) {
+                slot->done = 1;
+                slot->total = 1;
+            }
+            updateProgress();
+            m_slots.erase(slot);
+            delete slot;
+        }
+        return ReturnCode::OK;
+    }
+
+private:
+    void updateProgress()
+    {
+        double total = 0;
+        double done = 0;
+        for (DownloadSlot *slot : m_slots) {
+            if (slot->total > 0) {
+                total += slot->total;
+                done += std::min(slot->done, slot->total);
+            }
+        }
+        // Map download phase into 10–70%
+        int pct = 10;
+        if (total > 0) {
+            pct = 10 + static_cast<int>((done / total) * 60.0);
+        } else if (!m_slots.empty()) {
+            pct = 15;
+        }
+        m_reporter.setAtLeast(std::min(pct, 70));
+    }
+
+    ProgressReporter &m_reporter;
+    std::set<DownloadSlot *> m_slots;
+};
