+#include "Dnf5Transaction.h"
+#include "Dnf5Backend.h"
+#include "Dnf5Resource.h"
+
+#include <QDebug>
+#include <QTimer>
+
+#include <libdnf5/base/goal.hpp>
+#include <libdnf5/base/transaction.hpp>
+
+Dnf5Transaction::Dnf5Transaction(Dnf5Backend *backend, Dnf5Resource *resource, Role role)
+    : Transaction(backend, resource, role)
+    , m_backend(backend)
+    , m_resource(resource)
+{
+    setCancellable(false);
+    setStatus(SetupStatus);
+    QTimer::singleShot(0, this, &Dnf5Transaction::run);
+}
+
+void Dnf5Transaction::cancel()
+{
+    m_cancelled = true;
+    setStatus(CancelledStatus);
+}
+
+void Dnf5Transaction::run()
+{
+    if (m_cancelled) {
+        return;
+    }
+
+    setStatus(DownloadingStatus);
+    setProgress(10);
+
+    bool success = false;
+    try {
+        auto &base = m_backend->dnfBase();
+        libdnf5::Goal goal(base);
+
+        const auto pkgName = m_resource->packageName().toStdString();
+
+        if (role() == InstallRole) {
+            goal.add_install(pkgName);
+        } else if (role() == RemoveRole) {
+            goal.add_remove(pkgName);
+        }
+
+        setProgress(30);
+        auto transaction = goal.resolve();
+        auto problems = transaction.get_problems();
+        if (problems != libdnf5::GoalProblem::NO_PROBLEM) {
+            const auto logs = transaction.get_resolve_logs_as_strings();
+            for (const auto &msg : logs) {
+                qWarning() << "DNF5 resolve:" << QString::fromStdString(msg);
+            }
+        } else {
+            setStatus(CommittingStatus);
+            setProgress(50);
+            transaction.download();
+            setProgress(70);
+            auto result = transaction.run();
+            success = (result == libdnf5::base::Transaction::TransactionRunResult::SUCCESS);
+            if (!success) {
+                const auto msgs = transaction.get_transaction_problems();
+                for (const auto &msg : msgs) {
+                    qWarning() << "DNF5 transaction:" << QString::fromStdString(msg);
+                }
+            }
+        }
+    } catch (const std::exception &ex) {
+        qWarning() << "DNF5 transaction failed:" << ex.what();
+    }
+
+    finishTransaction(success);
+}
+
+void Dnf5Transaction::finishTransaction(bool success)
+{
+    if (m_cancelled) {
+        return;
+    }
+
+    setProgress(100);
+    if (success) {
+        if (role() == InstallRole) {
+            m_resource->setState(AbstractResource::Installed);
+        } else if (role() == RemoveRole) {
+            m_resource->setState(AbstractResource::None);
+        }
+        setStatus(DoneStatus);
+    } else {
+        Q_EMIT passiveMessage(QStringLiteral("DNF5 transaction failed for %1").arg(m_resource->name()));
+        setStatus(DoneWithErrorStatus);
+    }
+}
+
+#include "moc_Dnf5Transaction.cpp"
