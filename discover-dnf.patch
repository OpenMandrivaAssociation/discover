diff --git a/libdiscover/backends/Dnf5Backend/Dnf5Backend.cpp b/libdiscover/backends/Dnf5Backend/Dnf5Backend.cpp
new file mode 100644
index 0000000..dac07c9
--- /dev/null
+++ b/libdiscover/backends/Dnf5Backend/Dnf5Backend.cpp
@@ -0,0 +1,228 @@
+/*
+ *   SPDX-FileCopyrightText: 2025 KDE Developers
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "Dnf5Backend.h"
+#include "Dnf5Resource.h"
+#include "Dnf5SourcesBackend.h"
+#include "Dnf5Transaction.h"
+
+#include <resources/SourcesModel.h>
+#include <resources/StandardBackendUpdater.h>
+
+#include <KLocalizedString>
+
+#include <QDebug>
+#include <QTimer>
+
+#include <libdnf5/base/goal.hpp>
+#include <libdnf5/rpm/package_query.hpp>
+#include <libdnf5/repo/repo_query.hpp>
+
+DISCOVER_BACKEND_PLUGIN(Dnf5Backend)
+
+Dnf5Backend::Dnf5Backend(QObject *parent)
+    : AbstractResourcesBackend(parent)
+    , m_base(std::make_unique<libdnf5::Base>())
+    , m_updater(new StandardBackendUpdater(this))
+{
+    connect(m_updater, &StandardBackendUpdater::updatesCountChanged, this, &Dnf5Backend::updatesCountChanged);
+
+    m_sources = new Dnf5SourcesBackend(this);
+    SourcesModel::global()->addSourcesBackend(m_sources);
+
+    try {
+        m_base->load_config();
+        m_base->setup();
+        m_base->get_repo_sack()->create_repos_from_system_configuration();
+        m_base->get_repo_sack()->load_repos();
+        m_valid = true;
+    } catch (const std::exception &ex) {
+        qWarning() << "DNF5 backend init failed:" << ex.what();
+        m_valid = false;
+    }
+
+    if (m_valid) {
+        loadPackages();
+        m_sources->loadRepositories();
+    }
+
+    QTimer::singleShot(0, this, [this]() {
+        Q_EMIT contentsChanged();
+    });
+}
+
+Dnf5Backend::~Dnf5Backend() = default;
+
+void Dnf5Backend::loadPackages()
+{
+    if (!m_valid) {
+        return;
+    }
+
+    try {
+        // Query installed packages
+        libdnf5::rpm::PackageQuery installedQuery(*m_base);
+        installedQuery.filter_installed();
+        // Keep only the latest version per name.arch
+        installedQuery.filter_latest_evr();
+
+        for (const auto &pkg : installedQuery) {
+            const auto key = QString::fromStdString(pkg.get_na());
+            auto *resource = new Dnf5Resource(pkg, AbstractResource::System, this);
+            resource->setState(AbstractResource::Installed);
+            m_resources.insert(key, resource);
+            connect(resource, &Dnf5Resource::stateChanged, this, &Dnf5Backend::updatesCountChanged);
+        }
+
+        // Query available upgrades
+        libdnf5::rpm::PackageQuery upgradeQuery(*m_base);
+        upgradeQuery.filter_upgrades();
+        upgradeQuery.filter_latest_evr();
+
+        for (const auto &pkg : upgradeQuery) {
+            const auto key = QString::fromStdString(pkg.get_na());
+            auto it = m_resources.find(key);
+            if (it != m_resources.end()) {
+                (*it)->setAvailablePackage(pkg);
+                (*it)->setState(AbstractResource::Upgradeable);
+            }
+        }
+
+        // Query available (not installed) packages
+        libdnf5::rpm::PackageQuery availableQuery(*m_base);
+        availableQuery.filter_available();
+        availableQuery.filter_latest_evr();
+
+        for (const auto &pkg : availableQuery) {
+            const auto key = QString::fromStdString(pkg.get_na());
+            if (!m_resources.contains(key)) {
+                auto *resource = new Dnf5Resource(pkg, AbstractResource::Application, this);
+                resource->setState(AbstractResource::None);
+                m_resources.insert(key, resource);
+            }
+        }
+    } catch (const std::exception &ex) {
+        qWarning() << "DNF5 loadPackages failed:" << ex.what();
+    }
+}
+
+ResultsStream *Dnf5Backend::search(const AbstractResourcesBackend::Filters &filter)
+{
+    QVector<StreamResult> results;
+
+    if (!filter.resourceUrl.isEmpty()) {
+        const auto scheme = filter.resourceUrl.scheme();
+        if (scheme == QLatin1String("dnf")) {
+            const auto name = filter.resourceUrl.host();
+            auto it = m_resources.constFind(name);
+            if (it != m_resources.constEnd()) {
+                results += *it;
+            }
+        }
+        return new ResultsStream(QStringLiteral("Dnf5Stream"), results);
+    }
+
+    for (auto *res : std::as_const(m_resources)) {
+        if (res->state() < filter.state) {
+            continue;
+        }
+
+        // Hide system packages from browse view unless looking for updates
+        if (res->type() == AbstractResource::System && filter.state != AbstractResource::Upgradeable) {
+            continue;
+        }
+
+        if (!filter.search.isEmpty()) {
+            if (!res->name().contains(filter.search, Qt::CaseInsensitive)
+                && !res->comment().contains(filter.search, Qt::CaseInsensitive)) {
+                continue;
+            }
+        }
+
+        results += res;
+    }
+
+    return new ResultsStream(QStringLiteral("Dnf5Stream"), results);
+}
+
+int Dnf5Backend::updatesCount() const
+{
+    return m_updater->updatesCount();
+}
+
+AbstractBackendUpdater *Dnf5Backend::backendUpdater() const
+{
+    return m_updater;
+}
+
+AbstractReviewsBackend *Dnf5Backend::reviewsBackend() const
+{
+    return nullptr;
+}
+
+Transaction *Dnf5Backend::installApplication(AbstractResource *app, const AddonList & /*addons*/)
+{
+    return new Dnf5Transaction(this, qobject_cast<Dnf5Resource *>(app), Transaction::InstallRole);
+}
+
+Transaction *Dnf5Backend::installApplication(AbstractResource *app)
+{
+    return new Dnf5Transaction(this, qobject_cast<Dnf5Resource *>(app), Transaction::InstallRole);
+}
+
+Transaction *Dnf5Backend::removeApplication(AbstractResource *app)
+{
+    return new Dnf5Transaction(this, qobject_cast<Dnf5Resource *>(app), Transaction::RemoveRole);
+}
+
+void Dnf5Backend::checkForUpdates()
+{
+    if (m_fetching) {
+        return;
+    }
+
+    m_fetching = true;
+    m_fetchProgress = 0;
+    Q_EMIT fetchingUpdatesProgressChanged();
+
+    reloadRepoData();
+}
+
+QString Dnf5Backend::displayName() const
+{
+    return QStringLiteral("DNF 5");
+}
+
+void Dnf5Backend::reloadRepoData()
+{
+    try {
+        m_base = std::make_unique<libdnf5::Base>();
+        m_base->load_config();
+        m_base->setup();
+        m_base->get_repo_sack()->create_repos_from_system_configuration();
+        m_base->get_repo_sack()->load_repos();
+
+        qDeleteAll(m_resources);
+        m_resources.clear();
+        loadPackages();
+        m_sources->loadRepositories();
+    } catch (const std::exception &ex) {
+        qWarning() << "DNF5 checkForUpdates failed:" << ex.what();
+    }
+
+    m_fetching = false;
+    m_fetchProgress = 100;
+    Q_EMIT fetchingUpdatesProgressChanged();
+    Q_EMIT contentsChanged();
+}
+
+int Dnf5Backend::fetchingUpdatesProgress() const
+{
+    return m_fetching ? m_fetchProgress : 100;
+}
+
+#include "Dnf5Backend.moc"
+#include "moc_Dnf5Backend.cpp"
