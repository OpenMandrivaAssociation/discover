new file mode 100644
index 0000000..f0465a0
--- /dev/null
+++ b/libdiscover/backends/Dnf5Backend/tests/dnf5_cli_info.cpp
@@ -0,0 +1,120 @@
+/*
+ *   SPDX-FileCopyrightText: 2025 KDE Developers
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ *
+ *   CLI tool to show detailed information about a single package.
+ *
+ *   Usage:
+ *     dnf5_cli_info <package-name>
+ */
+
+#include <QCoreApplication>
+#include <QCommandLineParser>
+#include <QSignalSpy>
+#include <QDebug>
+
+#include "DiscoverBackendsFactory.h"
+#include <resources/AbstractResourcesBackend.h>
+#include <resources/ResourcesModel.h>
+
+static AbstractResourcesBackend *findDnf5Backend(ResourcesModel *model)
+{
+    for (auto *backend : model->backends()) {
+        if (QString::fromLatin1(backend->metaObject()->className()) == QLatin1String("Dnf5Backend")) {
+            return backend;
+        }
+    }
+    return nullptr;
+}
+
+static QVector<StreamResult> fetchAll(ResultsStream *stream)
+{
+    QVector<StreamResult> results;
+    QObject::connect(stream, &ResultsStream::resourcesFound, stream, [&results](const QVector<StreamResult> &res) {
+        results += res;
+    });
+    QSignalSpy spy(stream, &ResultsStream::destroyed);
+    spy.wait(30000);
+    return results;
+}
+
+int main(int argc, char *argv[])
+{
+    QCoreApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("dnf5_cli_info"));
+
+    QCommandLineParser parser;
+    parser.setApplicationDescription(QStringLiteral("CLI tool for testing the DNF5 Discover backend — package info"));
+    parser.addHelpOption();
+    parser.addPositionalArgument(QStringLiteral("package"), QStringLiteral("Package name to look up"));
+    parser.process(app);
+
+    const auto args = parser.positionalArguments();
+    if (args.isEmpty()) {
+        parser.showHelp(1);
+    }
+    const auto &pkgName = args.first();
+
+    DiscoverBackendsFactory::setRequestedBackends({QStringLiteral("dnf5-backend")});
+
+    auto *model = new ResourcesModel(QStringLiteral("dnf5-backend"), &app);
+    auto *backend = findDnf5Backend(model);
+
+    if (!backend) {
+        qCritical() << "DNF5 backend not found.";
+        return 1;
+    }
+
+    if (!backend->isValid()) {
+        QSignalSpy spy(backend, &AbstractResourcesBackend::contentsChanged);
+        if (!spy.wait(60000)) {
+            qCritical() << "Timeout waiting for backend.";
+            return 1;
+        }
+    }
+
+    AbstractResourcesBackend::Filters filter;
+    filter.search = pkgName;
+    const auto results = fetchAll(backend->search(filter));
+
+    AbstractResource *found = nullptr;
+    for (const auto &sr : results) {
+        if (sr.resource->packageName() == pkgName) {
+            found = sr.resource;
+            break;
+        }
+    }
+
+    if (!found) {
+        qCritical().noquote() << QStringLiteral("Package '%1' not found.").arg(pkgName);
+        return 1;
+    }
+
+    auto stateStr = [](AbstractResource::State s) -> QString {
+        switch (s) {
+        case AbstractResource::None: return QStringLiteral("available");
+        case AbstractResource::Installed: return QStringLiteral("installed");
+        case AbstractResource::Upgradeable: return QStringLiteral("upgradeable");
+        default: return QStringLiteral("broken");
+        }
+    };
+
+    qInfo().noquote() << QStringLiteral("Name:              %1").arg(found->name());
+    qInfo().noquote() << QStringLiteral("Package Name:      %1").arg(found->packageName());
+    qInfo().noquote() << QStringLiteral("Summary:           %1").arg(found->comment());
+    qInfo().noquote() << QStringLiteral("State:             %1").arg(stateStr(found->state()));
+    qInfo().noquote() << QStringLiteral("Installed Version: %1").arg(found->installedVersion());
+    qInfo().noquote() << QStringLiteral("Available Version: %1").arg(found->availableVersion());
+    qInfo().noquote() << QStringLiteral("Size:              %1").arg(found->size());
+    qInfo().noquote() << QStringLiteral("Section:           %1").arg(found->section());
+    qInfo().noquote() << QStringLiteral("Origin:            %1").arg(found->origin());
+    qInfo().noquote() << QStringLiteral("Homepage:          %1").arg(found->homepage().toString());
+    qInfo().noquote() << QStringLiteral("Author:            %1").arg(found->author());
+    qInfo().noquote() << QStringLiteral("License:           %1").arg(
+        QJsonDocument(found->licenses().first().toObject()).toJson(QJsonDocument::Compact));
+    qInfo().noquote() << QStringLiteral("Description:");
+    qInfo().noquote() << found->longDescription();
+
+    return 0;
+}
