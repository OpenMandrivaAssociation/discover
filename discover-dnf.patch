@@ -0,0 +1,141 @@
+/*
+ *   SPDX-FileCopyrightText: 2025 KDE Developers
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "Dnf5Resource.h"
+#include "Dnf5Backend.h"
+
+#include <QDateTime>
+#include <QJsonObject>
+
+Dnf5Resource::Dnf5Resource(libdnf5::rpm::Package pkg, AbstractResource::Type type, Dnf5Backend *parent)
+    : AbstractResource(parent)
+    , m_pkg(std::move(pkg))
+    , m_type(type)
+{
+}
+
+QString Dnf5Resource::packageName() const
+{
+    return QString::fromStdString(m_pkg.get_name());
+}
+
+QString Dnf5Resource::name() const
+{
+    return QString::fromStdString(m_pkg.get_name());
+}
+
+QString Dnf5Resource::comment()
+{
+    return QString::fromStdString(m_pkg.get_summary());
+}
+
+QVariant Dnf5Resource::icon() const
+{
+    return QStringLiteral("package-x-generic");
+}
+
+AbstractResource::State Dnf5Resource::state()
+{
+    return m_state;
+}
+
+bool Dnf5Resource::hasCategory(const QString &category) const
+{
+    const auto group = QString::fromStdString(m_pkg.get_group());
+    return group.contains(category, Qt::CaseInsensitive);
+}
+
+QUrl Dnf5Resource::homepage()
+{
+    return QUrl(QString::fromStdString(m_pkg.get_url()));
+}
+
+QJsonArray Dnf5Resource::licenses()
+{
+    return {QJsonObject{{QStringLiteral("name"), QString::fromStdString(m_pkg.get_license())}}};
+}
+
+quint64 Dnf5Resource::size()
+{
+    if (m_pkg.is_installed()) {
+        return m_pkg.get_install_size();
+    }
+    return m_pkg.get_download_size();
+}
+
+QString Dnf5Resource::installedVersion() const
+{
+    if (m_pkg.is_installed()) {
+        return QString::fromStdString(m_pkg.get_evr());
+    }
+    return {};
+}
+
+QString Dnf5Resource::availableVersion() const
+{
+    if (m_availablePkg.has_value()) {
+        return QString::fromStdString(m_availablePkg->get_evr());
+    }
+    if (!m_pkg.is_installed()) {
+        return QString::fromStdString(m_pkg.get_evr());
+    }
+    return {};
+}
+
+QString Dnf5Resource::longDescription()
+{
+    return QString::fromStdString(m_pkg.get_description());
+}
+
+QString Dnf5Resource::origin() const
+{
+    return QString::fromStdString(m_pkg.get_repo_id());
+}
+
+QString Dnf5Resource::section()
+{
+    return QString::fromStdString(m_pkg.get_group());
+}
+
+QString Dnf5Resource::author() const
+{
+    return QString::fromStdString(m_pkg.get_packager());
+}
+
+void Dnf5Resource::fetchChangelog()
+{
+    QString changelog;
+    for (const auto &entry : m_pkg.get_changelogs()) {
+        const auto dt = QDateTime::fromSecsSinceEpoch(entry.get_timestamp());
+        changelog += QStringLiteral("<p><b>%1 - %2</b><br/>%3</p>")
+                         .arg(dt.toString(Qt::ISODate),
+                              QString::fromStdString(entry.get_author()),
+                              QString::fromStdString(entry.get_text()));
+    }
+    Q_EMIT changelogFetched(changelog);
+}
+
+QDate Dnf5Resource::releaseDate() const
+{
+    const auto buildTime = m_pkg.get_build_time();
+    if (buildTime > 0) {
+        return QDateTime::fromSecsSinceEpoch(buildTime).date();
+    }
+    return {};
+}
+
+void Dnf5Resource::setState(AbstractResource::State state)
+{
+    m_state = state;
+    Q_EMIT stateChanged();
+}
+
+void Dnf5Resource::setAvailablePackage(const libdnf5::rpm::Package &pkg)
+{
+    m_availablePkg = pkg;
+}
+
+#include "moc_Dnf5Resource.cpp"
