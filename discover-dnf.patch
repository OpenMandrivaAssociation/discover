new file mode 100644
index 0000000..c78447d
--- /dev/null
+++ b/libdiscover/backends/Dnf5Backend/tests/dnf5_cli_list.cpp
@@ -0,0 +1,123 @@
+/*
+ *   SPDX-FileCopyrightText: 2025 KDE Developers
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ *
+ *   CLI tool to exercise the DNF5 Discover backend listing and searching.
+ *
+ *   Usage:
+ *     dnf5_cli_list                  — list all resources loaded by the backend
+ *     dnf5_cli_list --search <term>  — search resources by name/summary
+ *     dnf5_cli_list --installed      — show only installed packages
+ *     dnf5_cli_list --upgradeable    — show only upgradeable packages
+ */
+
+#include <QCoreApplication>
+#include <QCommandLineParser>
+#include <QSignalSpy>
+#include <QTimer>
+#include <QDebug>
+
+#include "DiscoverBackendsFactory.h"
+#include <resources/AbstractResourcesBackend.h>
+#include <resources/ResourcesModel.h>
+
+static AbstractResourcesBackend *findDnf5Backend(ResourcesModel *model)
+{
+    for (auto *backend : model->backends()) {
+        if (QString::fromLatin1(backend->metaObject()->className()) == QLatin1String("Dnf5Backend")) {
+            return backend;
+        }
+    }
+    return nullptr;
+}
+
+static QVector<StreamResult> fetchAll(ResultsStream *stream)
+{
+    QVector<StreamResult> results;
+    QObject::connect(stream, &ResultsStream::resourcesFound, stream, [&results](const QVector<StreamResult> &res) {
+        results += res;
+    });
+    QSignalSpy spy(stream, &ResultsStream::destroyed);
+    spy.wait(30000);
+    return results;
+}
+
+int main(int argc, char *argv[])
+{
+    QCoreApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("dnf5_cli_list"));
+
+    QCommandLineParser parser;
+    parser.setApplicationDescription(QStringLiteral("CLI tool for testing the DNF5 Discover backend — list & search"));
+    parser.addHelpOption();
+
+    QCommandLineOption searchOpt(QStringLiteral("search"), QStringLiteral("Search term"), QStringLiteral("term"));
+    QCommandLineOption installedOpt(QStringLiteral("installed"), QStringLiteral("Show installed packages only"));
+    QCommandLineOption upgradeableOpt(QStringLiteral("upgradeable"), QStringLiteral("Show upgradeable packages only"));
+
+    parser.addOption(searchOpt);
+    parser.addOption(installedOpt);
+    parser.addOption(upgradeableOpt);
+    parser.process(app);
+
+    DiscoverBackendsFactory::setRequestedBackends({QStringLiteral("dnf5-backend")});
+
+    auto *model = new ResourcesModel(QStringLiteral("dnf5-backend"), &app);
+    auto *backend = findDnf5Backend(model);
+
+    if (!backend) {
+        qCritical() << "DNF5 backend not found. Make sure it is built and in the plugin path.";
+        return 1;
+    }
+
+    // Wait for the backend to finish loading
+    if (!backend->isValid()) {
+        QSignalSpy spy(backend, &AbstractResourcesBackend::contentsChanged);
+        if (!spy.wait(60000)) {
+            qCritical() << "Timeout waiting for DNF5 backend to initialize.";
+            return 1;
+        }
+    }
+
+    if (!backend->isValid()) {
+        qCritical() << "DNF5 backend is not valid after initialization.";
+        return 1;
+    }
+
+    AbstractResourcesBackend::Filters filter;
+    if (parser.isSet(installedOpt)) {
+        filter.state = AbstractResource::Installed;
+    } else if (parser.isSet(upgradeableOpt)) {
+        filter.state = AbstractResource::Upgradeable;
+    }
+    if (parser.isSet(searchOpt)) {
+        filter.search = parser.value(searchOpt);
+    }
+
+    const auto results = fetchAll(backend->search(filter));
+
+    qInfo().noquote() << QStringLiteral("Found %1 package(s):").arg(results.size());
+    qInfo().noquote() << QStringLiteral("%-40s %-20s %-20s %s").arg(
+        QStringLiteral("NAME"), QStringLiteral("INSTALLED"), QStringLiteral("AVAILABLE"), QStringLiteral("STATE"));
+    qInfo().noquote() << QString(100, QLatin1Char('-'));
+
+    for (const auto &sr : results) {
+        auto *res = sr.resource;
+        QString stateStr;
+        switch (res->state()) {
+        case AbstractResource::None: stateStr = QStringLiteral("available"); break;
+        case AbstractResource::Installed: stateStr = QStringLiteral("installed"); break;
+        case AbstractResource::Upgradeable: stateStr = QStringLiteral("upgradeable"); break;
+        default: stateStr = QStringLiteral("broken"); break;
+        }
+
+        qInfo().noquote() << QStringLiteral("%-40s %-20s %-20s %s")
+                                 .arg(res->packageName().left(40),
+                                      res->installedVersion().left(20),
+                                      res->availableVersion().left(20),
+                                      stateStr);
+    }
+
+    return 0;
+}
