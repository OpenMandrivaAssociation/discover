+/*
+ *   SPDX-FileCopyrightText: 2025 KDE Developers
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "Dnf5SourcesBackend.h"
+#include "Dnf5Backend.h"
+
+#include <QDebug>
+
+#include <libdnf5/repo/repo_query.hpp>
+
+Dnf5SourcesBackend::Dnf5SourcesBackend(AbstractResourcesBackend *parent)
+    : AbstractSourcesBackend(parent)
+    , m_model(new QStandardItemModel(this))
+{
+}
+
+void Dnf5SourcesBackend::loadRepositories()
+{
+    auto *backend = qobject_cast<Dnf5Backend *>(resourcesBackend());
+    if (!backend) {
+        return;
+    }
+
+    m_model->clear();
+
+    try {
+        libdnf5::repo::RepoQuery query(backend->dnfBase());
+        for (const auto &repo : query) {
+            auto *item = new QStandardItem(QString::fromStdString(repo->get_id()));
+            item->setData(QString::fromStdString(repo->get_id()), AbstractSourcesBackend::IdRole);
+            const auto name = QString::fromStdString(repo->get_name());
+            item->setData(name, Qt::ToolTipRole);
+            item->setCheckable(true);
+            item->setCheckState(repo->is_enabled() ? Qt::Checked : Qt::Unchecked);
+            m_model->appendRow(item);
+        }
+    } catch (const std::exception &ex) {
+        qWarning() << "Failed to load DNF5 repositories:" << ex.what();
+    }
+}
+
+QAbstractItemModel *Dnf5SourcesBackend::sources()
+{
+    return m_model;
+}
+
+bool Dnf5SourcesBackend::addSource(const QString &id)
+{
+    Q_UNUSED(id);
+    return false;
+}
+
+QStandardItem *Dnf5SourcesBackend::sourceForId(const QString &id) const
+{
+    for (int i = 0, c = m_model->rowCount(); i < c; ++i) {
+        auto *it = m_model->item(i, 0);
+        if (it->data(AbstractSourcesBackend::IdRole).toString() == id) {
+            return it;
+        }
+    }
+    return nullptr;
+}
+
+bool Dnf5SourcesBackend::removeSource(const QString &id)
+{
+    Q_UNUSED(id);
+    Q_EMIT passiveMessage(QStringLiteral("Removing DNF repositories is not supported via Discover."));
+    return false;
+}
+
+QVariantList Dnf5SourcesBackend::actions() const
+{
+    return {};
+}
+
+#include "moc_Dnf5SourcesBackend.cpp"
