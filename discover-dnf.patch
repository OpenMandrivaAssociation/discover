+ *
+ *   CLI tool to exercise the DNF5 Discover backend update checking.
+ *
+ *   Usage:
+ *     dnf5_cli_updates              — check for updates and list them
+ *     dnf5_cli_updates --refresh    — force a refresh before checking
+ */
+
+#include <QCoreApplication>
+#include <QCommandLineParser>
+#include <QSignalSpy>
+#include <QDebug>
+
+#include "DiscoverBackendsFactory.h"
+#include <resources/AbstractBackendUpdater.h>
+#include <resources/AbstractResourcesBackend.h>
+#include <resources/ResourcesModel.h>
+#include <resources/ResourcesUpdatesModel.h>
+
+static AbstractResourcesBackend *findDnf5Backend(ResourcesModel *model)
+{
+    for (auto *backend : model->backends()) {
+        if (QString::fromLatin1(backend->metaObject()->className()) == QLatin1String("Dnf5Backend")) {
+            return backend;
+        }
+    }
+    return nullptr;
+}
+
+static QVector<StreamResult> fetchAll(ResultsStream *stream)
+{
+    QVector<StreamResult> results;
+    QObject::connect(stream, &ResultsStream::resourcesFound, stream, [&results](const QVector<StreamResult> &res) {
+        results += res;
+    });
+    QSignalSpy spy(stream, &ResultsStream::destroyed);
+    spy.wait(30000);
+    return results;
+}
+
+int main(int argc, char *argv[])
+{
+    QCoreApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("dnf5_cli_updates"));
+
+    QCommandLineParser parser;
+    parser.setApplicationDescription(QStringLiteral("CLI tool for testing the DNF5 Discover backend — update check"));
+    parser.addHelpOption();
+
+    QCommandLineOption refreshOpt(QStringLiteral("refresh"), QStringLiteral("Force repository metadata refresh"));
+    parser.addOption(refreshOpt);
+    parser.process(app);
+
+    DiscoverBackendsFactory::setRequestedBackends({QStringLiteral("dnf5-backend")});
+
+    auto *model = new ResourcesModel(QStringLiteral("dnf5-backend"), &app);
+    auto *backend = findDnf5Backend(model);
+
+    if (!backend) {
+        qCritical() << "DNF5 backend not found.";
+        return 1;
+    }
+
+    if (!backend->isValid()) {
+        QSignalSpy spy(backend, &AbstractResourcesBackend::contentsChanged);
+        if (!spy.wait(60000)) {
+            qCritical() << "Timeout waiting for backend.";
+            return 1;
+        }
+    }
+
+    if (parser.isSet(refreshOpt)) {
+        qInfo() << "Refreshing repository metadata...";
+        backend->checkForUpdates();
+        QSignalSpy spy(backend, &AbstractResourcesBackend::contentsChanged);
+        if (!spy.wait(120000)) {
+            qWarning() << "Timeout waiting for refresh (may still be in progress).";
+        }
+    }
+
+    qInfo().noquote() << QStringLiteral("Updates count: %1").arg(backend->updatesCount());
+    qInfo().noquote() << QStringLiteral("Backend valid: %1").arg(backend->isValid() ? QStringLiteral("yes") : QStringLiteral("no"));
+
+    // Search for upgradeable resources
+    AbstractResourcesBackend::Filters filter;
+    filter.state = AbstractResource::Upgradeable;
+    const auto results = fetchAll(backend->search(filter));
+
+    if (results.isEmpty()) {
+        qInfo() << "No updates available.";
+    } else {
+        qInfo().noquote() << QStringLiteral("\nAvailable updates (%1):").arg(results.size());
+        qInfo().noquote() << QStringLiteral("%-40s %-20s %-20s").arg(
+            QStringLiteral("PACKAGE"), QStringLiteral("INSTALLED"), QStringLiteral("AVAILABLE"));
+        qInfo().noquote() << QString(80, QLatin1Char('-'));
+        for (const auto &sr : results) {
+            auto *res = sr.resource;
+            qInfo().noquote() << QStringLiteral("%-40s %-20s %-20s")
+                                     .arg(res->packageName().left(40),
+                                          res->installedVersion().left(20),
+                                          res->availableVersion().left(20));
+        }
+    }
+
+    return 0;
+}
