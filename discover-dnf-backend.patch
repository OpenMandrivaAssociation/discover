@@ -0,0 +1,411 @@
+/*
+ *   SPDX-FileCopyrightText: 2026 Discover DNF backend authors
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "DnfBackend.h"
+#include "DnfSourcesBackend.h"
+#include "DnfTransaction.h"
+#include "dnf_backend_logging.h"
+
+#include "Category/Category.h"
+#include "appstream/OdrsReviewsBackend.h"
+#include "resources/SourcesModel.h"
+#include "resources/StandardBackendUpdater.h"
+
+#include <AppStreamQt/pool.h>
+#include <KLocalizedString>
+
+#include <QFutureWatcher>
+#include <QTimer>
+#include <QtConcurrentRun>
+
+DISCOVER_BACKEND_PLUGIN(DnfBackend)
+
+DnfBackend::DnfBackend(QObject *parent)
+    : AbstractResourcesBackend(parent)
+    , m_context(new DnfContext)
+    , m_appStreamComponents(AppStream::ComponentBox::Flag::FlagNone)
+    , m_updater(new StandardBackendUpdater(this))
+    , m_reviews(OdrsReviewsBackend::global())
+{
+    connect(m_updater, &StandardBackendUpdater::updatesCountChanged, this, &DnfBackend::updatesCountChanged);
+    connect(m_reviews.data(), &OdrsReviewsBackend::ratingsReady, this, &AbstractResourcesBackend::emitRatingsReady);
+
+    SourcesModel::global()->addSourcesBackend(new DnfSourcesBackend(this));
+
+    m_fetching = true;
+    m_fetchProgress = 10;
+    Q_EMIT fetchingUpdatesProgressChanged();
+
+    auto future = QtConcurrent::run([this]() {
+        return loadInBackground();
+    });
+    // Apply results on the object thread when ready
+    auto *watcher = new QFutureWatcher<LoadResult>(this);
+    connect(watcher, &QFutureWatcher<LoadResult>::finished, this, [this, watcher]() {
+        onLoadFinished(watcher->result());
+        watcher->deleteLater();
+    });
+    watcher->setFuture(future);
+}
+
+DnfBackend::~DnfBackend() = default;
+
+DnfBackend::LoadResult DnfBackend::loadInBackground()
+{
+    LoadResult result;
+    QString error;
+    if (!m_context->load(&error)) {
+        result.ok = false;
+        result.error = error;
+        qCWarning(LOG_DNF) << "Failed to initialize libdnf5:" << error;
+        return result;
+    }
+    result.ok = true;
+
+    AppStream::Pool pool;
+    pool.setFlags(AppStream::Pool::Flags(AppStream::Pool::Flag::FlagLoadOsCatalog | AppStream::Pool::Flag::FlagLoadOsDesktopFiles
+                                         | AppStream::Pool::Flag::FlagLoadOsMetainfo));
+    if (!pool.load()) {
+        qCWarning(LOG_DNF) << "AppStream pool load failed:" << pool.lastError();
+    } else {
+        result.components = pool.components();
+        for (const AppStream::Component &component : std::as_const(result.components)) {
+            const QStringList pkgs = component.packageNames();
+            for (const QString &pkg : pkgs) {
+                if (!result.appstreamByPackage.contains(pkg)) {
+                    result.appstreamByPackage.insert(pkg, component);
+                }
+            }
+        }
+        qCDebug(LOG_DNF) << "Loaded" << result.components.size() << "AppStream components," << result.appstreamByPackage.size() << "package mappings";
+    }
+    return result;
+}
+
+void DnfBackend::onLoadFinished(const LoadResult &result)
+{
+    m_valid = result.ok;
+    if (!m_valid) {
+        m_fetching = false;
+        m_fetchProgress = 100;
+        Q_EMIT fetchingUpdatesProgressChanged();
+        Q_EMIT invalidated();
+        return;
+    }
+
+    m_appStreamComponents = result.components;
+    m_appstreamByPackage = result.appstreamByPackage;
+
+    refreshResourcesFromContext();
+    m_fetching = false;
+    m_fetchProgress = 100;
+    Q_EMIT fetchingUpdatesProgressChanged();
+    Q_EMIT contentsChanged();
+
+    QTimer::singleShot(500, this, &DnfBackend::checkForUpdates);
+}
+
+AppStream::Component DnfBackend::componentForPackage(const QString &packageName) const
+{
+    return m_appstreamByPackage.value(packageName);
+}
+
+AbstractResource::Type DnfBackend::resourceTypeForComponent(const AppStream::Component &component) const
+{
+    switch (component.kind()) {
+    case AppStream::Component::KindDesktopApp:
+    case AppStream::Component::KindConsoleApp:
+    case AppStream::Component::KindWebApp:
+        return AbstractResource::Application;
+    case AppStream::Component::KindAddon:
+        return AbstractResource::Addon;
+    default:
+        return AbstractResource::System;
+    }
+}
+
+DnfResource *DnfBackend::ensureResource(const DnfPackageInfo &info)
+{
+    const QString key = info.name;
+    DnfResource *res = m_resources.value(key);
+    if (res) {
+        res->setPackageInfo(info);
+        return res;
+    }
+
+    const AppStream::Component component = componentForPackage(info.name);
+    const AbstractResource::Type type = component.id().isEmpty() ? AbstractResource::System : resourceTypeForComponent(component);
+    res = new DnfResource(info, component, type, this);
+    m_resources.insert(key, res);
+    connect(res, &DnfResource::stateChanged, this, &DnfBackend::updatesCountChanged);
+    return res;
+}
+
+void DnfBackend::refreshResourcesFromContext()
+{
+    QSet<QString> seen;
+
+    const auto upgradeable = m_context->upgradeablePackages();
+    for (const DnfPackageInfo &info : upgradeable) {
+        ensureResource(info);
+        seen.insert(info.name);
+    }
+
+    for (auto it = m_appstreamByPackage.constBegin(); it != m_appstreamByPackage.constEnd(); ++it) {
+        if (seen.contains(it.key())) {
+            continue;
+        }
+        auto pkg = m_context->findPackage(it.key());
+        if (pkg) {
+            ensureResource(*pkg);
+            seen.insert(it.key());
+        }
+    }
+
+    const auto installed = m_context->installedPackages();
+    for (const DnfPackageInfo &info : installed) {
+        if (seen.contains(info.name)) {
+            if (DnfResource *res = m_resources.value(info.name)) {
+                // Preserve upgradeable flag if already set
+                DnfPackageInfo copy = info;
+                if (res->state() == AbstractResource::Upgradeable) {
+                    copy.upgradeable = true;
+                    copy.availableVersion = res->availableVersion();
+                }
+                res->setPackageInfo(copy);
+            }
+            continue;
+        }
+        ensureResource(info);
+        seen.insert(info.name);
+    }
+
+    qCDebug(LOG_DNF) << "Resources loaded:" << m_resources.size();
+}
+
+bool DnfBackend::isValid() const
+{
+    return true; // Always load; empty if libdnf5 init failed
+}
+
+ResultsStream *DnfBackend::search(const Filters &filter)
+{
+    if (!filter.resourceUrl.isEmpty()) {
+        return findResourceByPackageName(filter.resourceUrl);
+    }
+
+    QVector<StreamResult> results;
+
+    if (!filter.search.isEmpty() && m_context && m_context->isLoaded()) {
+        const auto matches = m_context->searchPackages(filter.search, 500);
+        for (const DnfPackageInfo &info : matches) {
+            ensureResource(info);
+        }
+    }
+
+    for (DnfResource *resource : std::as_const(m_resources)) {
+        if (filter.filterMinimumState && resource->state() < filter.state) {
+            continue;
+        }
+
+        if (resource->type() == AbstractResource::System && filter.state != AbstractResource::Upgradeable && filter.search.isEmpty()
+            && filter.state != AbstractResource::Installed) {
+            continue;
+        }
+
+        if (!filter.search.isEmpty()) {
+            if (!resource->name().contains(filter.search, Qt::CaseInsensitive) && !resource->packageName().contains(filter.search, Qt::CaseInsensitive)
+                && !resource->comment().contains(filter.search, Qt::CaseInsensitive)) {
+                continue;
+            }
+        }
+
+        if (filter.category && !resource->categoryMatches(filter.category)) {
+            continue;
+        }
+
+        results += resource;
+    }
+
+    return new ResultsStream(QStringLiteral("DnfStream"), results);
+}
+
+ResultsStream *DnfBackend::findResourceByPackageName(const QUrl &searchUrl)
+{
+    DnfResource *result = nullptr;
+
+    if (searchUrl.scheme() == QLatin1String("appstream")) {
+        const QString id = searchUrl.host().isEmpty() ? searchUrl.path().mid(1) : searchUrl.host() + searchUrl.path();
+        for (DnfResource *res : std::as_const(m_resources)) {
+            if (res->appstreamId() == id || res->appstreamId() == searchUrl.host()) {
+                result = res;
+                break;
+            }
+        }
+        if (!result) {
+            for (auto it = m_appstreamByPackage.constBegin(); it != m_appstreamByPackage.constEnd(); ++it) {
+                if (it.value().id() == searchUrl.host() || it.value().id() == id) {
+                    auto pkg = m_context->findPackage(it.key());
+                    if (pkg) {
+                        result = ensureResource(*pkg);
+                    }
+                    break;
+                }
+            }
+        }
+    } else if (searchUrl.scheme() == QLatin1String("dnf") || searchUrl.scheme() == QLatin1String("package")) {
+        const QString name = searchUrl.host().isEmpty() ? searchUrl.path().mid(1) : searchUrl.host();
+        result = m_resources.value(name);
+        if (!result && m_context) {
+            auto pkg = m_context->findPackage(name);
+            if (pkg) {
+                result = ensureResource(*pkg);
+            }
+        }
+    }
+
+    if (!result) {
+        return new ResultsStream(QStringLiteral("DnfStream"), {});
+    }
+    return new ResultsStream(QStringLiteral("DnfStream"), {result});
+}
