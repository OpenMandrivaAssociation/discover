+
+void DnfBackend::markTransactionFinished(DnfResource *resource, Transaction::Role role, bool success)
+{
+    if (!success || !resource) {
+        return;
+    }
+    // Reload package metadata after transaction
+    m_context->refresh(nullptr);
+    auto pkg = m_context->findPackage(resource->packageName());
+    if (pkg) {
+        if (role == Transaction::RemoveRole) {
+            pkg->installed = false;
+            pkg->upgradeable = false;
+            pkg->installedVersion.clear();
+        }
+        resource->setPackageInfo(*pkg);
+    } else if (role == Transaction::RemoveRole) {
+        resource->setState(AbstractResource::None);
+    }
+    Q_EMIT resourcesChanged(resource, {"state", "status", "installedVersion", "availableVersion", "size"});
+    Q_EMIT updatesCountChanged();
+}
+
+void DnfBackend::setFetchingProgress(int progress)
+{
+    m_fetchProgress = progress;
+    Q_EMIT fetchingUpdatesProgressChanged();
+}
