diff --git a/cli/main.cpp b/cli/main.cpp
new file mode 100644
index 0000000..454ed78
--- /dev/null
+++ b/cli/main.cpp
@@ -0,0 +1,274 @@
+/*
+ *   SPDX-FileCopyrightText: 2026 Discover DNF backend authors
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "../DiscoverVersion.h"
+
+#include <DiscoverBackendsFactory.h>
+#include <Transaction/Transaction.h>
+#include <resources/AbstractResource.h>
+#include <resources/AbstractResourcesBackend.h>
+#include <resources/ResourcesModel.h>
+#include <resources/SourcesModel.h>
+
+#include <KAboutData>
+#include <KLocalizedString>
+
+#include <QCommandLineParser>
+#include <QCoreApplication>
+#include <QEventLoop>
+#include <QTextStream>
+#include <QTimer>
+#include <cstdlib>
+
+using namespace Qt::StringLiterals;
+
+static QTextStream out(stdout);
+static QTextStream err(stderr);
+
+static void waitForBackendsReady(ResourcesModel *model)
+{
+    auto ready = [model]() {
+        return !model->isInitializing() && model->fetchingUpdatesProgress() >= 100;
+    };
+    if (ready()) {
+        return;
+    }
+    QEventLoop loop;
+    auto maybeQuit = [&]() {
+        if (ready()) {
+            loop.quit();
+        }
+    };
+    QObject::connect(model, &ResourcesModel::fetchingUpdatesProgressChanged, &loop, maybeQuit);
+    QObject::connect(model, &ResourcesModel::backendsChanged, &loop, maybeQuit);
+    QTimer poll;
+    QObject::connect(&poll, &QTimer::timeout, &loop, maybeQuit);
+    poll.start(200);
+    QTimer::singleShot(180000, &loop, &QEventLoop::quit);
+    loop.exec();
+}
+
+static QVector<AbstractResource *> collectSearch(ResourcesModel *model, const AbstractResourcesBackend::Filters &filters)
+{
+    QVector<AbstractResource *> resources;
+    QSet<ResultsStream *> pending;
+    QEventLoop loop;
+
+    const auto backends = model->backends();
+    for (AbstractResourcesBackend *backend : backends) {
+        ResultsStream *stream = backend->search(filters);
+        pending.insert(stream);
+        QObject::connect(stream, &ResultsStream::resourcesFound, &loop, [&resources](const QVector<StreamResult> &results) {
+            for (const StreamResult &r : results) {
+                resources << r.resource;
+            }
+        });
+        QObject::connect(stream, &QObject::destroyed, &loop, [&pending, &loop, stream]() {
+            pending.remove(stream);
+            if (pending.isEmpty()) {
+                loop.quit();
+            }
+        });
+    }
+
+    if (pending.isEmpty()) {
+        return resources;
+    }
+
+    QTimer::singleShot(120000, &loop, &QEventLoop::quit);
+    loop.exec();
+    return resources;
+}
+
+static int runTransaction(Transaction *tx)
+{
+    if (!tx) {
+        err << "Failed to create transaction\n";
+        err.flush();
+        return 1;
+    }
+    QEventLoop loop;
+    int exitCode = 1;
+    QObject::connect(tx, &Transaction::statusChanged, &loop, [&](Transaction::Status status) {
+        switch (status) {
+        case Transaction::DoneStatus:
+            exitCode = 0;
+            loop.quit();
+            break;
+        case Transaction::DoneWithErrorStatus:
+        case Transaction::CancelledStatus:
+            exitCode = 1;
+            loop.quit();
+            break;
+        default:
+            break;
+        }
+    });
+    if (tx->status() == Transaction::DoneStatus) {
+        return 0;
+    }
+    if (tx->status() == Transaction::DoneWithErrorStatus || tx->status() == Transaction::CancelledStatus) {
+        return 1;
+    }
+    QTimer::singleShot(60 * 60 * 1000, &loop, &QEventLoop::quit);
+    loop.exec();
+    return exitCode;
+}
+
+static void printResource(AbstractResource *res)
+{
+    out << res->packageName() << '\t' << res->name() << '\t';
+    switch (res->state()) {
+    case AbstractResource::Broken:
+        out << "broken";
+        break;
+    case AbstractResource::None:
+        out << "available";
+        break;
+    case AbstractResource::Installed:
+        out << "installed";
+        break;
+    case AbstractResource::Upgradeable:
+        out << "upgradeable";
+        break;
+    }
+    out << '\t' << res->installedVersion() << '\t' << res->availableVersion() << '\t' << res->origin() << '\n';
+}
+
+static AbstractResource *findPackage(ResourcesModel *model, const QString &packageName)
+{
+    for (const QString &scheme : {QStringLiteral("dnf"), QStringLiteral("package")}) {
+        AbstractResourcesBackend::Filters filters;
+        filters.resourceUrl = QUrl(scheme + QStringLiteral("://") + packageName);
+        const auto resources = collectSearch(model, filters);
+        for (AbstractResource *res : resources) {
+            if (res->packageName() == packageName) {
+                return res;
+            }
+        }
+    }
+
+    AbstractResourcesBackend::Filters filters;
+    filters.search = packageName;
+    filters.filterMinimumState = false;
+    const auto resources = collectSearch(model, filters);
+    for (AbstractResource *res : resources) {
+        if (res->packageName() == packageName) {
+            return res;
+        }
+    }
+    return nullptr;
+}
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    KLocalizedString::setApplicationDomain("plasma-discover-cli");
+
+    KAboutData about(QStringLiteral("plasma-discover-cli"),
+                     i18n("Discover CLI"),
+                     version,
+                     i18n("Command-line interface to Discover package backends"),
+                     KAboutLicense::GPL,
+                     i18n("© 2026"));
+    about.setProductName("discover/cli");
+
+    QCommandLineParser parser;
+    parser.setApplicationDescription(i18n("Test and automate Discover backends (especially DNF)"));
+    parser.addHelpOption();
+    parser.addVersionOption();
+    parser.addPositionalArgument(QStringLiteral("command"),
+                                 i18n("Command: list, search, install, remove, updates, check-updates, sources, backends"),
+                                 QStringLiteral("command"));
+    parser.addPositionalArgument(QStringLiteral("args"), i18n("Command arguments"), QStringLiteral("[args...]"));
+
+    DiscoverBackendsFactory::setupCommandLine(&parser);
+    about.setupCommandLine(&parser);
+    parser.process(app);
+    about.processCommandLine(&parser);
+    DiscoverBackendsFactory::processCommandLine(&parser, false);
+
+    const QStringList positional = parser.positionalArguments();
+    if (positional.isEmpty()) {
+        parser.showHelp(1);
+    }
+
+    const QString command = positional.at(0);
+    const QStringList args = positional.mid(1);
+
+    ResourcesModel *model = ResourcesModel::global();
+    waitForBackendsReady(model);
+
+    int exitCode = 0;
+
+    if (command == u"backends") {
+        for (AbstractResourcesBackend *b : model->backends()) {
+            out << b->name() << '\t' << b->displayName() << '\t' << (b->isValid() ? "valid" : "invalid") << "\tfetching=" << b->fetchingUpdatesProgress()
+                << '\n';
+        }
+    } else if (command == u"list" || command == u"search") {
+        AbstractResourcesBackend::Filters filters;
+        if (!args.isEmpty()) {
+            filters.search = args.join(QLatin1Char(' '));
+        }
+        filters.filterMinimumState = false;
+        const auto resources = collectSearch(model, filters);
+        out << "# package\tname\tstate\tinstalled\tavailable\torigin\n";
+        for (AbstractResource *res : resources) {
+            printResource(res);
+        }
+        out << "# count: " << resources.size() << '\n';
+    } else if (command == u"updates" || command == u"check-updates") {
+        for (AbstractResourcesBackend *b : model->backends()) {
+            b->checkForUpdates();
+        }
+        waitForBackendsReady(model);
+
+        AbstractResourcesBackend::Filters filters;
+        filters.state = AbstractResource::Upgradeable;
+        filters.filterMinimumState = true;
+        const auto resources = collectSearch(model, filters);
+        out << "# upgradeable packages\n";
+        for (AbstractResource *res : resources) {
+            printResource(res);
+        }
+        out << "# updates: " << resources.size() << '\n';
+        for (AbstractResourcesBackend *b : model->backends()) {
+            out << "# backend " << b->name() << " updatesCount=" << b->updatesCount() << '\n';
+        }
+    } else if (command == u"install" || command == u"remove") {
+        if (args.isEmpty()) {
+            err << "Package name required\n";
+            err.flush();
+            return 1;
+        }
+        const QString packageName = args.at(0);
+        AbstractResource *target = findPackage(model, packageName);
+        if (!target) {
+            err << "Package not found: " << packageName << '\n';
+            err.flush();
+            return 1;
+        }
+        out << (command == u"install" ? "Installing " : "Removing ") << target->packageName() << " via " << target->backend()->name() << '\n';
+        out.flush();
+        Transaction *tx = (command == u"install") ? target->backend()->installApplication(target) : target->backend()->removeApplication(target);
+        exitCode = runTransaction(tx);
+    } else if (command == u"sources") {
+        SourcesModel *sources = SourcesModel::global();
+        for (int i = 0; i < sources->rowCount(); ++i) {
+            const QModelIndex idx = sources->index(i, 0);
+            out << sources->data(idx, Qt::DisplayRole).toString() << '\n';
+        }
+    } else {
+        err << "Unknown command: " << command << '\n';
+        err.flush();
+        parser.showHelp(1);
+    }
+
+    out.flush();
+    // Avoid teardown crashes from backend-owned resources; exit immediately.
+    ::_Exit(exitCode);
+}
