+{
+    return false;
+}
+
+bool DnfSourcesBackend::removeSource(const QString &)
+{
+    return false;
+}
+
+QAbstractItemModel *DnfSourcesBackend::sources()
+{
+    return m_sourcesModel;
+}
+
+QVariantList DnfSourcesBackend::actions() const
+{
+    return {};
+}
+
+bool DnfSourcesBackend::supportsAdding() const
+{
+    return false;
+}
+
+void DnfSourcesBackend::loadSources()
+{
+    m_sourcesModel->clear();
+    if (!m_backend->context() || !m_backend->context()->isLoaded()) {
+        return;
+    }
+    const auto repos = m_backend->context()->repositories();
+    for (const DnfRepoInfo &repo : repos) {
+        if (repo.id == QLatin1String("@System") || repo.id.startsWith(QLatin1Char('@'))) {
+            continue;
+        }
+        auto *item = new QStandardItem(repo.name.isEmpty() ? repo.id : repo.name);
+        item->setData(repo.id, AbstractSourcesBackend::IdRole);
+        item->setData(repo.baseurl, Qt::ToolTipRole);
+        item->setCheckable(true);
+        item->setCheckState(repo.enabled ? Qt::Checked : Qt::Unchecked);
+        m_sourcesModel->appendRow(item);
+    }
+}
+
+void DnfSourcesBackend::onItemChanged(QStandardItem *item)
+{
+    if (!item) {
+        return;
+    }
+    const QString id = item->data(AbstractSourcesBackend::IdRole).toString();
+    const bool enabled = item->checkState() == Qt::Checked;
+    QString error;
+    if (!m_backend->context()->setRepositoryEnabled(id, enabled, &error)) {
+        qCWarning(LOG_DNF) << "Failed to toggle repo" << id << error;
+    }
+}
