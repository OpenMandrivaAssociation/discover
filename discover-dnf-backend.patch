diff --git a/libdiscover/backends/DnfBackend/DnfTransaction.cpp b/libdiscover/backends/DnfBackend/DnfTransaction.cpp
new file mode 100644
index 0000000..fb27ea6
--- /dev/null
+++ b/libdiscover/backends/DnfBackend/DnfTransaction.cpp
@@ -0,0 +1,116 @@
+/*
+ *   SPDX-FileCopyrightText: 2026 Discover DNF backend authors
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "DnfTransaction.h"
+#include "DnfBackend.h"
+#include "DnfResource.h"
+#include "dnf_backend_logging.h"
+
+#include <KAuth/Action>
+#include <KAuth/ExecuteJob>
+#include <KLocalizedString>
+
+#include <QFutureWatcher>
+#include <QtConcurrentRun>
+#include <unistd.h>
+
+DnfTransaction::DnfTransaction(DnfResource *resource, Role role)
+    : Transaction(resource->backend(), resource, role)
+    , m_resource(resource)
+    , m_backend(static_cast<DnfBackend *>(resource->backend()))
+{
+    setCancellable(false);
+    setStatus(QueuedStatus);
+    startTransaction();
+}
+
+void DnfTransaction::cancel()
+{
+    setStatus(CancelledStatus);
+}
+
+void DnfTransaction::proceed()
+{
+    startTransaction();
+}
+
+void DnfTransaction::finishOk()
+{
+    setProgress(100);
+    setStatus(DoneStatus);
+    m_backend->markTransactionFinished(m_resource, role(), true);
+}
+
+void DnfTransaction::finishError(const QString &message)
+{
+    qCWarning(LOG_DNF) << "Transaction failed:" << message;
+    Q_EMIT passiveMessage(message);
+    setStatus(DoneWithErrorStatus);
+    m_backend->markTransactionFinished(m_resource, role(), false);
+}
+
+void DnfTransaction::startTransaction()
+{
+    const QString action = (role() == InstallRole) ? QStringLiteral("install") : QStringLiteral("remove");
+    const QStringList packages{m_resource->packageName()};
+
+    setProgress(5);
+    setStatus(role() == InstallRole ? DownloadingStatus : CommittingStatus);
+
+    // If running as root (e.g. automated CLI tests), call libdnf5 directly.
+    if (geteuid() == 0) {
+        auto future = QtConcurrent::run([backend = m_backend, action, packages]() {
+            QString error;
+            const bool ok = backend->context()->runTransaction(action, packages, &error);
+            return QPair<bool, QString>(ok, error);
+        });
+        auto *watcher = new QFutureWatcher<QPair<bool, QString>>(this);
+        connect(watcher, &QFutureWatcher<QPair<bool, QString>>::finished, this, [this, watcher]() {
+            const auto result = watcher->result();
+            if (result.first) {
+                finishOk();
+            } else {
+                finishError(result.second.isEmpty() ? i18n("DNF transaction failed") : result.second);
+            }
+            watcher->deleteLater();
+        });
+        watcher->setFuture(future);
+        return;
+    }
+
+    // Non-root: elevate via KAuth helper
+    KAuth::Action kaction(QStringLiteral("org.kde.discover.dnfbackend.pkgmgmt"));
+    kaction.setHelperId(QStringLiteral("org.kde.discover.dnfbackend"));
+    if (!kaction.isValid()) {
+        finishError(i18n("DNF authorization action is invalid"));
+        return;
+    }
+    kaction.setTimeout(60 * 60 * 1000);
+    kaction.addArgument(QStringLiteral("pkgAction"), action);
+    kaction.addArgument(QStringLiteral("packages"), packages);
+
+    KAuth::ExecuteJob *job = kaction.execute();
+    connect(job, &KAuth::ExecuteJob::percentChanged, this, [this](KJob *, unsigned long percent) {
+        if (percent >= 40 && role() == InstallRole) {
+            setStatus(CommittingStatus);
+        }
+        setProgress(static_cast<int>(percent));
+    });
+    connect(job, &KAuth::ExecuteJob::result, this, [this](KJob *job) {
+        auto *reply = static_cast<KAuth::ExecuteJob *>(job);
+        if (reply->error() == 0) {
+            finishOk();
+        } else {
+            const QVariantMap data = reply->data();
+            QString message = data.value(QStringLiteral("errorString"), reply->errorString()).toString();
+            if (reply->error() == KAuth::ActionReply::AuthorizationDeniedError) {
+                message = i18n("Error: Authorization denied");
+            }
+            finishError(message);
+        }
+    });
+    job->start();
+}
