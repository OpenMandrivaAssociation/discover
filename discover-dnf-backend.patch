+using libdnf5::sack::QueryCmp;
+
+static QString fromStd(const std::string &s)
+{
+    return QString::fromStdString(s);
+}
+
+DnfContext::DnfContext() = default;
+
+DnfContext::~DnfContext() = default;
+
+std::unique_ptr<libdnf5::Base> DnfContext::createBase(QString *error) const
+{
+    try {
+        auto base = std::make_unique<libdnf5::Base>();
+        base->load_config();
+        // Avoid loading host plugins that may fail in constrained environments
+        // but keep normal behavior when plugins work; leave plugins enabled by default.
+        base->setup();
+        auto repo_sack = base->get_repo_sack();
+        repo_sack->create_repos_from_system_configuration();
+        // Read lock is enough for queries; transactions take write lock separately.
+        base->lock_system_repo(libdnf5::utils::LockAccess::READ, libdnf5::utils::LockBlocking::BLOCKING);
+        repo_sack->load_repos();
+        return base;
+    } catch (const std::exception &e) {
+        if (error) {
+            *error = QString::fromUtf8(e.what());
+        }
+        return nullptr;
+    }
+}
+
+bool DnfContext::setupBase(QString *error)
+{
+    m_base = createBase(error);
+    m_loaded = static_cast<bool>(m_base);
+    return m_loaded;
+}
+
+bool DnfContext::load(QString *error)
+{
+    QMutexLocker lock(&m_mutex);
+    m_base.reset();
+    m_loaded = false;
+    return setupBase(error);
+}
+
+bool DnfContext::refresh(QString *error)
+{
+    // Recreate Base so load_repos can run again (metadata will be refreshed if stale).
+    return load(error);
+}
+
+DnfPackageInfo DnfContext::packageToInfo(const libdnf5::rpm::Package &pkg, bool installed, bool upgradeable) const
+{
+    DnfPackageInfo info;
+    info.name = fromStd(pkg.get_name());
+    info.arch = fromStd(pkg.get_arch());
+    info.summary = fromStd(pkg.get_summary());
+    info.description = fromStd(pkg.get_description());
+    info.license = fromStd(pkg.get_license());
+    info.availableVersion = fromStd(pkg.get_evr());
+    info.repoId = fromStd(pkg.get_repo_id());
+    info.url = fromStd(pkg.get_url());
+    info.downloadSize = pkg.get_download_size();
+    info.installSize = pkg.get_install_size();
+    info.installed = installed;
+    info.upgradeable = upgradeable;
+    if (installed || upgradeable) {
+        // Prefer installed EVR from installed package if available later by caller
+        info.installedVersion = info.availableVersion;
+    }
+    return info;
+}
+
+QVector<DnfPackageInfo> DnfContext::allLatestPackages() const
+{
+    QMutexLocker lock(&m_mutex);
+    QVector<DnfPackageInfo> result;
+    if (!m_base) {
+        return result;
+    }
+
+    try {
+        std::set<std::string> upgradeableNames;
+        {
+            libdnf5::rpm::PackageQuery upq(*m_base);
+            upq.filter_upgradable();
+            for (const auto &pkg : upq) {
+                upgradeableNames.insert(pkg.get_name());
+            }
+        }
+
+        std::map<std::string, std::string> installedEvr;
+        {
+            libdnf5::rpm::PackageQuery inst(*m_base);
+            inst.filter_installed();
+            for (const auto &pkg : inst) {
+                installedEvr[pkg.get_name()] = pkg.get_evr();
+            }
+        }
+
+        libdnf5::rpm::PackageQuery query(*m_base);
+        query.filter_latest_evr();
+        result.reserve(20000);
+        for (const auto &pkg : query) {
+            // Skip pure installed-only entries that have a newer available version represented separately;
+            // filter_latest_evr returns latest per name.arch including from @System.
+            const auto name = pkg.get_name();
+            const bool isInstalled = pkg.is_installed();
+            const bool upgradeable = upgradeableNames.count(name) > 0;
+
+            // Prefer available (non-system) package as the "latest" display entry when both exist.
+            // When iterating latest_evr we get one per name+arch; if installed is latest, it's the installed one.
+            DnfPackageInfo info = packageToInfo(pkg, isInstalled || installedEvr.count(name), upgradeable);
+            auto it = installedEvr.find(name);
+            if (it != installedEvr.end()) {
+                info.installed = true;
+                info.installedVersion = fromStd(it->second);
+                if (!isInstalled) {
+                    info.availableVersion = fromStd(pkg.get_evr());
+                }
+            }
+            if (upgradeable && !isInstalled) {
+                info.upgradeable = true;
+            }
+            if (upgradeable && isInstalled) {
+                // Will be superseded by available package if present; still mark for updates count
+                info.upgradeable = true;
+            }
+            result.push_back(std::move(info));
+        }
+    } catch (const std::exception &) {
+        // return what we have
+    }
+    return result;
+}
+
+QVector<DnfPackageInfo> DnfContext::searchPackages(const QString &term, int limit) const
+{
+    QMutexLocker lock(&m_mutex);
+    QVector<DnfPackageInfo> result;
+    if (!m_base || term.isEmpty()) {
+        return result;
+    }
+
+    try {
+        std::set<std::string> upgradeableNames;
+        {
+            libdnf5::rpm::PackageQuery upq(*m_base);
+            upq.filter_upgradable();
+            for (const auto &pkg : upq) {
+                upgradeableNames.insert(pkg.get_name());
+            }
+        }
+        std::map<std::string, std::string> installedEvr;
+        {
+            libdnf5::rpm::PackageQuery inst(*m_base);
+            inst.filter_installed();
+            for (const auto &pkg : inst) {
+                installedEvr[pkg.get_name()] = pkg.get_evr();
+            }
+        }
+
+        libdnf5::rpm::PackageQuery query(*m_base);
+        query.filter_name(term.toStdString(), QueryCmp::ICONTAINS);
+        query.filter_latest_evr();
+
+        int count = 0;
+        for (const auto &pkg : query) {
+            const auto name = pkg.get_name();
+            DnfPackageInfo info = packageToInfo(pkg, installedEvr.count(name) > 0, upgradeableNames.count(name) > 0);
+            auto it = installedEvr.find(name);
+            if (it != installedEvr.end()) {
+                info.installedVersion = fromStd(it->second);
+            }
+            result.push_back(std::move(info));
+            if (++count >= limit) {
+                break;
+            }
+        }
+    } catch (const std::exception &) {
+    }
+    return result;
+}
+
+QVector<DnfPackageInfo> DnfContext::installedPackages() const
+{
+    QMutexLocker lock(&m_mutex);
+    QVector<DnfPackageInfo> result;
+    if (!m_base) {
+        return result;
+    }
+    try {
+        std::set<std::string> upgradeableNames;
+        {
+            libdnf5::rpm::PackageQuery upq(*m_base);
+            upq.filter_upgradable();
+            for (const auto &pkg : upq) {
+                upgradeableNames.insert(pkg.get_name());
+            }
+        }
+
+        libdnf5::rpm::PackageQuery query(*m_base);
+        query.filter_installed();
+        for (const auto &pkg : query) {
+            DnfPackageInfo info = packageToInfo(pkg, true, upgradeableNames.count(pkg.get_name()) > 0);
+            info.installedVersion = fromStd(pkg.get_evr());
+            if (info.upgradeable) {
+                // available version from upgradeable query ideally; leave EVR as installed for now
+            }
+            result.push_back(std::move(info));
+        }
+    } catch (const std::exception &) {
+    }
+    return result;
+}
+
+QVector<DnfPackageInfo> DnfContext::upgradeablePackages() const
+{
+    QMutexLocker lock(&m_mutex);
+    QVector<DnfPackageInfo> result;
+    if (!m_base) {
+        return result;
+    }
+    try {
+        std::map<std::string, std::string> installedEvr;
+        {
+            libdnf5::rpm::PackageQuery inst(*m_base);
+            inst.filter_installed();
+            for (const auto &pkg : inst) {
+                installedEvr[pkg.get_name()] = pkg.get_evr();
+            }
+        }
+
+        libdnf5::rpm::PackageQuery query(*m_base);
+        query.filter_upgradable();
+        query.filter_latest_evr();
+        for (const auto &pkg : query) {
+            DnfPackageInfo info = packageToInfo(pkg, true, true);
+            auto it = installedEvr.find(pkg.get_name());
+            if (it != installedEvr.end()) {
+                info.installedVersion = fromStd(it->second);
+            }
+            info.availableVersion = fromStd(pkg.get_evr());
+            result.push_back(std::move(info));
+        }
+    } catch (const std::exception &) {
+    }
+    return result;
+}
+
+std::optional<DnfPackageInfo> DnfContext::findPackage(const QString &name) const
+{
+    QMutexLocker lock(&m_mutex);
+    if (!m_base || name.isEmpty()) {
+        return std::nullopt;
+    }
+    try {
+        const bool upgradeable = [&]() {
+            libdnf5::rpm::PackageQuery upq(*m_base);
+            upq.filter_name(name.toStdString());
+            upq.filter_upgradable();
+            return !upq.empty();
+        }();
+
+        std::string installedEvr;
+        {
+            libdnf5::rpm::PackageQuery inst(*m_base);
+            inst.filter_name(name.toStdString());
+            inst.filter_installed();
+            if (!inst.empty()) {
+                installedEvr = (*inst.begin()).get_evr();
+            }
+        }
+
+        libdnf5::rpm::PackageQuery query(*m_base);
+        query.filter_name(name.toStdString());
+        query.filter_latest_evr();
+        if (query.empty()) {
+            return std::nullopt;
+        }
+        // Prefer not-installed (available) package for latest version info
+        libdnf5::rpm::Package chosen = *query.begin();
+        for (const auto &pkg : query) {
+            if (!pkg.is_installed()) {
+                chosen = pkg;
+                break;
+            }
+        }
+        DnfPackageInfo info = packageToInfo(chosen, !installedEvr.empty(), upgradeable);
+        if (!installedEvr.empty()) {
+            info.installedVersion = fromStd(installedEvr);
+        }
+        return info;
+    } catch (const std::exception &) {
+        return std::nullopt;
+    }
+}
+
+QVector<DnfRepoInfo> DnfContext::repositories() const
+{
+    QMutexLocker lock(&m_mutex);
+    QVector<DnfRepoInfo> result;
+    if (!m_base) {
+        return result;
+    }
+    try {
+        libdnf5::repo::RepoQuery query(*m_base);
+        for (const auto &repo : query) {
+            DnfRepoInfo info;
+            info.id = fromStd(repo->get_id());
+            info.name = fromStd(repo->get_name());
+            info.enabled = repo->is_enabled();
+            const auto &urls = repo->get_config().get_baseurl_option().get_value();
+            if (!urls.empty()) {
+                info.baseurl = fromStd(urls.front());
+            }
+            result.push_back(std::move(info));
+        }
+    } catch (const std::exception &) {
+    }
+    return result;
+}
+
+bool DnfContext::runTransaction(const QString &action, const QStringList &packages, QString *error)
+{
+    // Transactions need a fresh Base with write lock
+    std::unique_ptr<libdnf5::Base> base;
+    try {
+        base = std::make_unique<libdnf5::Base>();
+        base->load_config();
+        base->setup();
+        auto repo_sack = base->get_repo_sack();
+        repo_sack->create_repos_from_system_configuration();
+        base->lock_system_repo(libdnf5::utils::LockAccess::WRITE, libdnf5::utils::LockBlocking::BLOCKING);
+        repo_sack->load_repos();
+
+        libdnf5::Goal goal(*base);
+        if (action == QLatin1String("install")) {
+            for (const QString &pkg : packages) {
+                goal.add_install(pkg.toStdString());
+            }
+        } else if (action == QLatin1String("remove")) {
+            for (const QString &pkg : packages) {
+                goal.add_remove(pkg.toStdString());
+            }
+        } else if (action == QLatin1String("upgrade")) {
+            if (packages.isEmpty()) {
+                goal.add_upgrade("*");
+            } else {
+                for (const QString &pkg : packages) {
+                    goal.add_upgrade(pkg.toStdString());
+                }
+            }
+        } else {
+            if (error) {
+                *error = QStringLiteral("Unknown action: %1").arg(action);
+            }
+            return false;
+        }
+
+        auto transaction = goal.resolve();
+        if (transaction.get_problems() != libdnf5::GoalProblem::NO_PROBLEM) {
+            if (error) {
+                const auto logs = transaction.get_resolve_logs_as_strings();
+                QStringList msgs;
+                for (const auto &l : logs) {
+                    msgs << fromStd(l);
+                }
+                *error = msgs.join(QLatin1Char('\n'));
+            }
+            return false;
+        }
+
+        transaction.download();
+        transaction.set_description("plasma-discover dnf-backend");
+        const auto result = transaction.run();
+        if (result != libdnf5::base::Transaction::TransactionRunResult::SUCCESS) {
+            if (error) {
+                *error = QStringLiteral("Transaction failed");
+            }
+            return false;
+        }
+    } catch (const std::exception &e) {
+        if (error) {
+            *error = QString::fromUtf8(e.what());
+        }
+        return false;
+    }
+
+    // Reload read-only context after successful mutation
+    {
+        QMutexLocker lock(&m_mutex);
+        m_base.reset();
+        m_loaded = false;
+        setupBase(nullptr);
+    }
+    return true;
+}
+
+bool DnfContext::setRepositoryEnabled(const QString &repoId, bool enabled, QString *error)
+{
+    // Enabling/disabling in memory only for the current session; persist by writing .repo is complex.
+    // For Discover we toggle in the active Base and also try to update the on-disk config via dnf option.
+    QMutexLocker lock(&m_mutex);
+    if (!m_base) {
+        if (error) {
+            *error = QStringLiteral("DNF context not loaded");
+        }
+        return false;
+    }
+    try {
+        libdnf5::repo::RepoQuery query(*m_base);
+        query.filter_id(repoId.toStdString());
+        if (query.empty()) {
+            if (error) {
+                *error = QStringLiteral("Repository not found: %1").arg(repoId);
+            }
+            return false;
+        }
+        auto repo = *query.begin();
+        if (enabled) {
+            repo->enable();
+        } else {
+            repo->disable();
+        }
+        return true;
+    } catch (const std::exception &e) {
+        if (error) {
+            *error = QString::fromUtf8(e.what());
+        }
+        return false;
+    }
+}
diff --git a/libdiscover/backends/DnfBackend/DnfContext.h b/libdiscover/backends/DnfBackend/DnfContext.h
new file mode 100644
index 0000000..279f584
--- /dev/null
+++ b/libdiscover/backends/DnfBackend/DnfContext.h
@@ -0,0 +1,91 @@
+/*
+ *   SPDX-FileCopyrightText: 2026 Discover DNF backend authors
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QMutex>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <libdnf5/base/base.hpp>
+#include <libdnf5/base/goal.hpp>
+#include <libdnf5/base/transaction.hpp>
+#include <libdnf5/repo/repo_query.hpp>
+#include <libdnf5/rpm/package_query.hpp>
+
+struct DnfPackageInfo {
+    QString name;
+    QString arch;
+    QString summary;
+    QString description;
+    QString license;
+    QString availableVersion;
+    QString installedVersion;
+    QString repoId;
+    QString url;
+    quint64 downloadSize = 0;
+    quint64 installSize = 0;
+    bool installed = false;
+    bool upgradeable = false;
+};
+
+struct DnfRepoInfo {
+    QString id;
+    QString name;
+    QString baseurl;
+    bool enabled = true;
+};
+
+/**
+ * Thin wrapper around libdnf5::Base providing thread-safe access for the Discover backend.
+ * load_repos() can only be called once per Base instance, so reload() recreates Base.
+ */
+class DnfContext
+{
+public:
+    DnfContext();
+    ~DnfContext();
+
+    /// Initialize / reload configuration and repositories. Thread-safe.
+    bool load(QString *error = nullptr);
+
+    /// Refresh metadata then reload. Prefer calling from a worker thread.
+    bool refresh(QString *error = nullptr);
+
+    QVector<DnfPackageInfo> allLatestPackages() const;
+    QVector<DnfPackageInfo> searchPackages(const QString &term, int limit = 500) const;
+    QVector<DnfPackageInfo> installedPackages() const;
+    QVector<DnfPackageInfo> upgradeablePackages() const;
+    std::optional<DnfPackageInfo> findPackage(const QString &name) const;
+
+    QVector<DnfRepoInfo> repositories() const;
+
+    /// Run install/remove/upgrade using libdnf5. Requires privileges for system changes.
+    /// @param action "install" | "remove" | "upgrade"
+    /// @param packages package names (empty for full upgrade when action is "upgrade")
+    bool runTransaction(const QString &action, const QStringList &packages, QString *error = nullptr);
+
+    bool setRepositoryEnabled(const QString &repoId, bool enabled, QString *error = nullptr);
+
+    bool isLoaded() const
+    {
+        return m_loaded;
+    }
+
+private:
+    DnfPackageInfo packageToInfo(const libdnf5::rpm::Package &pkg, bool installed, bool upgradeable) const;
+    bool setupBase(QString *error);
+    std::unique_ptr<libdnf5::Base> createBase(QString *error) const;
+
+    mutable QMutex m_mutex;
+    std::unique_ptr<libdnf5::Base> m_base;
+    bool m_loaded = false;
+};
