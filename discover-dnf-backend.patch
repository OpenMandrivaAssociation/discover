+/*
+ *   SPDX-FileCopyrightText: 2026 Discover DNF backend authors
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "DnfAuthHelper.h"
+#include "DnfContext.h"
+
+#include <KAuth/HelperSupport>
+
+#include <QVariant>
+
+ActionReply DnfAuthHelper::pkgmgmt(const QVariantMap &args)
+{
+    ActionReply reply;
+    const QString action = args.value(QStringLiteral("pkgAction")).toString();
+    const QStringList packages = args.value(QStringLiteral("packages")).toStringList();
+
+    HelperSupport::progressStep(10);
+
+    DnfContext ctx;
+    QString error;
+
+    if (action == QLatin1String("refresh") || action == QLatin1String("update")) {
+        if (!ctx.refresh(&error)) {
+            reply = ActionReply::HelperErrorReply();
+            reply.setErrorDescription(error);
+            reply.addData(QStringLiteral("errorString"), error);
+            return reply;
+        }
+        HelperSupport::progressStep(100);
+        return reply;
+    }
+
+    if (action == QLatin1String("install") || action == QLatin1String("remove") || action == QLatin1String("upgrade")) {
+        HelperSupport::progressStep(20);
+        if (!ctx.runTransaction(action, packages, &error)) {
+            reply = ActionReply::HelperErrorReply();
+            reply.setErrorDescription(error);
+            reply.addData(QStringLiteral("errorString"), error);
+            return reply;
+        }
+        HelperSupport::progressStep(100);
+        return reply;
+    }
+
+    reply = ActionReply::HelperErrorReply();
+    reply.setErrorDescription(QStringLiteral("Unknown pkgAction"));
+    reply.addData(QStringLiteral("errorString"), QStringLiteral("Unknown pkgAction: %1").arg(action));
+    return reply;
+}
+
+KAUTH_HELPER_MAIN("org.kde.discover.dnfbackend", DnfAuthHelper)
