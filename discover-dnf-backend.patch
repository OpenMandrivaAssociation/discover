+/*
+ *   SPDX-FileCopyrightText: 2026 Discover DNF backend authors
+ *
+ *   SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "DnfResource.h"
+
+#include "appstream/AppStreamUtils.h"
+
+#include <AppStreamQt/developer.h>
+#include <AppStreamQt/icon.h>
+#include <AppStreamQt/launchable.h>
+#include <AppStreamQt/release.h>
+
+#include <QIcon>
+#include <QJsonObject>
+#include <QProcess>
+
+DnfResource::DnfResource(const DnfPackageInfo &pkg, const AppStream::Component &component, AbstractResource::Type type, AbstractResourcesBackend *parent)
+    : AbstractResource(parent)
+    , m_pkg(pkg)
+    , m_component(component)
+    , m_type(type)
+{
+    if (pkg.upgradeable) {
+        m_state = AbstractResource::Upgradeable;
+    } else if (pkg.installed) {
+        m_state = AbstractResource::Installed;
+    } else {
+        m_state = AbstractResource::None;
+    }
+}
+
+bool DnfResource::hasAppStreamData() const
+{
+    return !m_component.id().isEmpty();
+}
+
+QString DnfResource::packageName() const
+{
+    return m_pkg.name;
+}
+
+QString DnfResource::name() const
+{
+    if (hasAppStreamData() && !m_component.name().isEmpty()) {
+        return m_component.name();
+    }
+    return m_pkg.name;
+}
+
+QString DnfResource::comment()
+{
+    if (hasAppStreamData() && !m_component.summary().isEmpty()) {
+        return m_component.summary();
+    }
+    return m_pkg.summary;
+}
+
+QVariant DnfResource::icon() const
+{
+    if (hasAppStreamData()) {
+        const auto icons = m_component.icons();
+        if (!icons.isEmpty()) {
+            const AppStream::Icon &appIcon = icons.first();
+            if (appIcon.kind() == AppStream::Icon::KindStock) {
+                return appIcon.name();
+            }
+            QIcon ico;
+            if (appIcon.kind() == AppStream::Icon::KindLocal || appIcon.kind() == AppStream::Icon::KindCached) {
+                ico.addFile(appIcon.url().toLocalFile(), appIcon.size());
+                if (!ico.isNull()) {
+                    return QVariant::fromValue(ico);
+                }
+            }
+        }
+    }
+    return QStringLiteral("package-x-generic");
+}
+
+bool DnfResource::canExecute() const
+{
+    if (m_type != AbstractResource::Application || m_state < AbstractResource::Installed) {
+        return false;
+    }
+    return !m_component.launchable(AppStream::Launchable::KindDesktopId).entries().isEmpty();
+}
+
+void DnfResource::invokeApplication() const
+{
+    const auto entries = m_component.launchable(AppStream::Launchable::KindDesktopId).entries();
+    if (!entries.isEmpty()) {
+        QProcess::startDetached(QStringLiteral("gtk-launch"), {entries.constFirst()});
+    }
+}
+
+AbstractResource::State DnfResource::state()
+{
+    return m_state;
+}
+
+bool DnfResource::hasCategory(const QString &category) const
+{
+    if (hasAppStreamData()) {
+        return m_component.categories().contains(category);
+    }
+    return category == QLatin1String("dnf_packages");
+}
+
+QUrl DnfResource::homepage()
+{
+    if (hasAppStreamData()) {
+        const QUrl u = m_component.url(AppStream::Component::UrlKindHomepage);
+        if (!u.isEmpty()) {
+            return u;
+        }
+    }
+    return QUrl::fromUserInput(m_pkg.url);
+}
+
+AbstractResource::Type DnfResource::type() const
+{
+    return m_type;
+}
+
+quint64 DnfResource::size()
+{
+    return m_pkg.downloadSize ? m_pkg.downloadSize : m_pkg.installSize;
+}
+
+QJsonArray DnfResource::licenses()
+{
+    if (hasAppStreamData()) {
+        return AppStreamUtils::licenses(m_component);
+    }
+    return {QJsonObject{
+        {QStringLiteral("name"), m_pkg.license},
+        {QStringLiteral("url"), QStringLiteral("https://spdx.org/license-list")},
+    }};
+}
+
+QString DnfResource::installedVersion() const
+{
+    return m_pkg.installedVersion;
+}
+
+QString DnfResource::availableVersion() const
+{
+    return m_pkg.availableVersion;
+}
+
+QString DnfResource::longDescription()
+{
+    if (hasAppStreamData() && !m_component.description().isEmpty()) {
+        return m_component.description();
+    }
+    return m_pkg.description;
+}
+
+QString DnfResource::origin() const
+{
+    return m_pkg.repoId;
+}
+
+QString DnfResource::section()
+{
+    return QStringLiteral("dnf");
+}
+
+QString DnfResource::author() const
+{
+    if (hasAppStreamData()) {
+        return m_component.developer().name();
+    }
+    return {};
+}
+
+QList<PackageState> DnfResource::addonsInformation()
+{
+    return {};
+}
+
+QString DnfResource::appstreamId() const
+{
+    return m_component.id();
+}
+
+QUrl DnfResource::url() const
+{
+    if (hasAppStreamData()) {
+        return QUrl(QStringLiteral("appstream://") + m_component.id());
+    }
+    return QUrl(QStringLiteral("dnf://") + m_pkg.name);
+}
+
+QString DnfResource::sourceIcon() const
+{
+    return QStringLiteral("folder-rpm");
+}
+
+QDate DnfResource::releaseDate() const
+{
+    if (hasAppStreamData()) {
+        const auto releases = m_component.releasesPlain().entries();
+        if (!releases.isEmpty()) {
+            return releases.constFirst().timestamp().date();
+        }
+    }
+    return {};
+}
+
+void DnfResource::fetchChangelog()
+{
+    if (hasAppStreamData()) {
+        Q_EMIT changelogFetched(AppStreamUtils::changelogToHtml(m_component));
+    } else {
+        Q_EMIT changelogFetched({});
+    }
+}
+
+void DnfResource::fetchScreenshots()
+{
+    if (hasAppStreamData()) {
+        Q_EMIT screenshotsFetched(AppStreamUtils::fetchScreenshots(m_component));
+    } else {
+        Q_EMIT screenshotsFetched({});
+    }
+}
+
+void DnfResource::setPackageInfo(const DnfPackageInfo &pkg)
+{
+    m_pkg = pkg;
+    if (pkg.upgradeable) {
+        setState(AbstractResource::Upgradeable);
+    } else if (pkg.installed) {
+        setState(AbstractResource::Installed);
+    } else {
+        setState(AbstractResource::None);
+    }
+    Q_EMIT versionsChanged();
+    Q_EMIT sizeChanged();
+}
+
+void DnfResource::setAppStreamData(const AppStream::Component &component)
+{
+    m_component = component;
+    Q_EMIT longDescriptionChanged();
+    Q_EMIT iconChanged();
+}
+
+void DnfResource::setState(State state)
+{
+    if (m_state != state) {
+        m_state = state;
+        Q_EMIT stateChanged();
+    }
+}
