+
+void DnfBackend::checkForUpdates()
+{
+    if (!m_context || !m_context->isLoaded()) {
+        return;
+    }
+
+    m_fetching = true;
+    m_fetchProgress = 20;
+    Q_EMIT fetchingUpdatesProgressChanged();
+
+    auto future = QtConcurrent::run([ctx = m_context]() {
+        QString error;
+        ctx->refresh(&error);
+        return error;
+    });
+    auto *watcher = new QFutureWatcher<QString>(this);
+    connect(watcher, &QFutureWatcher<QString>::finished, this, [this, watcher]() {
+        const QString error = watcher->result();
+        if (!error.isEmpty()) {
+            qCWarning(LOG_DNF) << "refresh:" << error;
+        }
+        const auto upgradeable = m_context->upgradeablePackages();
+        QSet<QString> upNames;
+        for (const DnfPackageInfo &info : upgradeable) {
+            upNames.insert(info.name);
+            ensureResource(info);
+        }
+        for (DnfResource *res : std::as_const(m_resources)) {
+            if (!upNames.contains(res->packageName()) && res->state() == AbstractResource::Upgradeable) {
+                auto pkg = m_context->findPackage(res->packageName());
+                if (pkg) {
+                    res->setPackageInfo(*pkg);
+                }
+            }
+        }
+        m_fetching = false;
+        m_fetchProgress = 100;
+        Q_EMIT fetchingUpdatesProgressChanged();
+        Q_EMIT updatesCountChanged();
+        Q_EMIT contentsChanged();
+        watcher->deleteLater();
+    });
+    watcher->setFuture(future);
+}
