+
+DnfSourcesBackend::DnfSourcesBackend(DnfBackend *parent)
+    : AbstractSourcesBackend(parent)
+    , m_backend(parent)
+    , m_sourcesModel(new QStandardItemModel(this))
+{
+    loadSources();
+    connect(m_sourcesModel, &QStandardItemModel::itemChanged, this, [this](QStandardItem *item) {
+        onItemChanged(item);
+    });
+}
+
+QString DnfSourcesBackend::idDescription()
+{
+    return i18n("Repository id");
+}
