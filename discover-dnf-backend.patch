+
+    void cancel() override;
+    void proceed() override;
+
+private:
+    void startTransaction();
+    void finishOk();
+    void finishError(const QString &message);
+
+    DnfResource *m_resource = nullptr;
+    DnfBackend *m_backend = nullptr;
+};
